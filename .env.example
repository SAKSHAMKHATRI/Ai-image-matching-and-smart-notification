PROFILE_DATABASE_PATH=backend/data/profiles.db

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Preferred: local path to the Firebase Admin service-account JSON file.
# The file must stay out of version control (already covered by .gitignore).
FIREBASE_SERVICE_ACCOUNT_PATH=replace-with-local-path-to-service-account-json
# Alternatives: inline JSON or the three individual fields below.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FIREBASE_CLIENT_EMAIL=replace-with-firebase-admin-client-email
FIREBASE_PRIVATE_KEY=replace-with-firebase-admin-private-key
FIREBASE_STORAGE_BUCKET=replace-with-firebase-storage-bucket

# Microsoft Foundry. Keep real values only in the local backend .env.
FOUNDRY_PROJECT_ENDPOINT=https://replace-with-foundry-resource.services.ai.azure.com/api/projects/replace-with-project-name
FOUNDRY_API_KEY=replace-with-foundry-api-key
FOUNDRY_MODEL_NAME=replace-with-deployed-model-name
FOUNDRY_EMBEDDING_MODEL_NAME=text-embedding-3-small
FOUNDRY_TIMEOUT_SECONDS=20
FOUNDRY_MAX_RETRIES=2

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-firebase-auth-domain
VITE_FIREBASE_PROJECT_ID=replace-with-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=replace-with-firebase-storage-bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-firebase-messaging-sender-id
VITE_FIREBASE_APP_ID=replace-with-firebase-app-id

# Never place real credentials in this file.
